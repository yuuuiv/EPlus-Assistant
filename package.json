{
  "name": "eplus-assistant",
  "version": "0.1.4",
  "private": true,
  "description": "Local-first Eplus account manager: view and import member data collected by the eplus-collector browser userscript",
  "main": "dist-electron/main/main.js",
  "scripts": {
    "dev": "npm run build:main && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && set ELECTRON_RUN_AS_NODE=&& electron .\"",
    "start": "npm run build && set ELECTRON_RUN_AS_NODE=&& set EPLUS_ASSISTANT_LOAD_DIST=1&& electron .",
    "build": "npm run build:main && vite build",
    "build:main": "tsc -p tsconfig.node.json",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run src",
    "dist:win": "npm run build && electron-builder --win",
    "dist:mac": "npm run build && electron-builder --mac"
  },
  "dependencies": {
    "sql.js": "^1.13.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/sql.js": "^1.4.11",
    "@vitejs/plugin-react": "^5.0.4",
    "concurrently": "^9.2.1",
    "electron": "^40.10.6",
    "electron-builder": "^26.0.12",
    "lucide-react": "^0.546.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "sonner": "^2.0.7",
    "typescript": "^5.9.3",
    "vaul": "^1.1.2",
    "vite": "^7.1.9",
    "vitest": "^3.2.4",
    "wait-on": "^9.0.1"
  },
  "build": {
    "appId": "dev.eplus-assistant.desktop",
    "productName": "EPlus Assistant",
    "asar": true,
    "publish": null,
    "files": [
      "dist/**/*",
      "dist-electron/main/**/*",
      "dist-electron/shared/**/*",
      "!dist-electron/**/*.test.js",
      "!dist-electron/**/*.test.js.map",
      "package.json"
    ],
    "directories": {
      "output": "release"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.utilities",
      "identity": null
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
